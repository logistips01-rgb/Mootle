# ─────────────────────────────────────────────────────────────
# Mootle — variables de entorno (copia este archivo a .env)
# NUNCA subas el archivo .env real al repositorio.
# ─────────────────────────────────────────────────────────────

# Clave de Firecrawl (https://www.firecrawl.dev) — formato fc-xxxxx
FIRECRAWL_API_KEY=

# ── Credenciales del Service Account de Firebase (Admin SDK) ──
# Se obtienen en: Firebase Console > Configuración del proyecto >
# Cuentas de servicio > Generar nueva clave privada.
# Solo se usan al ejecutar el crawler en LOCAL. En Cloud Functions
# las credenciales se inyectan automáticamente (no hace falta esto).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# IMPORTANTE: la clave va entre comillas y con los \n literales tal cual
# vienen en el JSON del service account.
FIREBASE_PRIVATE_KEY=""

# Límite de anuncios a descubrir por portal en cada ejecución (opcional)
CRAWL_MAP_LIMIT=100
