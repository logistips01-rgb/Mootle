# ─────────────────────────────────────────────────────────────
# Mootle — variables de entorno (copia este archivo a .env)
# NUNCA subas el archivo .env real al repositorio.
# ─────────────────────────────────────────────────────────────

# Clave de Firecrawl (https://www.firecrawl.dev) — formato fc-xxxxx
FIRECRAWL_API_KEY=

# ── Credenciales de Firebase (Admin SDK) ──
# RECOMENDADO (más fácil y sin errores): pon el archivo .json que descargaste
# de Firebase como `serviceAccount.json` en la raíz del proyecto. El crawler lo
# detecta solo y NO necesitas rellenar las 3 variables FIREBASE_* de abajo.
# (serviceAccount*.json ya está en .gitignore, no se sube al repo.)
#
# Alternativa: indicar la ruta del .json aquí.
#FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json
#
# Alternativa avanzada: pegar las credenciales sueltas (propenso a errores con
# la private_key en Windows; usa mejor el archivo .json de arriba).
# Solo se usan al ejecutar el crawler en LOCAL. En Cloud Functions las
# credenciales se inyectan automáticamente.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# IMPORTANTE: la clave va entre comillas y con los \n literales tal cual
# vienen en el JSON del service account.
FIREBASE_PRIVATE_KEY=""

# Límite de anuncios a descubrir por portal en cada ejecución (opcional)
CRAWL_MAP_LIMIT=100
