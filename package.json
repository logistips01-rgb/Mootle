  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@mendable/firecrawl-js": "^1.18.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.6.0"
  }
}
